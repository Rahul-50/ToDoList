@model List<ToDoList.Models.TodoItem>

@{
    ViewData["Title"] = "ToDo List";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="fa-solid fa-list-check"></i> Task Manager</h2>
        <a asp-controller="Todo" asp-action="Create" class="btn btn-success">
            <i class="fa fa-plus-circle"></i> Add Task
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="fa fa-info-circle"></i> No tasks available. Click <strong>Add Task</strong> to create one.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow border-left-@(item.IsCompleted ? "success" : "warning")">
                        <div class="card-body">
                            <h5 class="card-title">@item.Title</h5>
                            <p class="card-text">
                                Status:
                                @if (item.IsCompleted)
                                {
                                    <span class="badge bg-success"><i class="fa fa-check-circle"></i> Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="fa fa-hourglass-half"></i> Pending</span>
                                }
                            </p>
                            <div class="d-flex justify-content-end gap-2">
                                <a class="btn btn-sm btn-outline-primary" href="/Todo/Edit/@item.Id">
                                    <i class="fa fa-pen"></i> Edit
                                </a>
                                <a class="btn btn-sm btn-outline-danger" href="/Todo/Delete/@item.Id">
                                    <i class="fa fa-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
