@{
    ViewData["Title"] = "Add Task";
}

<div class="container mt-5 col-md-6">
    <h3 class="text-success mb-3"><i class="fa fa-plus-circle"></i> Add New Task</h3>
    <form method="post" class="p-4 shadow rounded bg-light">
        <div class="mb-3">
            <label class="form-label">Task Title</label>
            <input type="text" class="form-control" name="title" placeholder="Enter your task..." required />
        </div>
        <button type="submit" class="btn btn-success"><i class="fa fa-check"></i> Add</button>
        <a href="/Todo" class="btn btn-secondary">Cancel</a>
    </form>
</div>
