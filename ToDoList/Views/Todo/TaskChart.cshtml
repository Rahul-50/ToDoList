@{
    ViewData["Title"] = "Task Completion Chart";
}

<div class="container mt-5">
    <div class="card shadow p-4 mb-4">
        <h4 class="text-center text-primary mb-4">
            <i class="fa fa-chart-pie"></i> Task Completion Overview
        </h4>

        <div style="max-width: 300px; margin: auto;">
            <canvas id="taskChart" width="300" height="300"></canvas>
        </div>
    </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('taskChart').getContext('2d');
    const taskChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Completed', 'Pending'],
            datasets: [{
                label: 'Tasks',
                data: [@ViewBag.Completed, @ViewBag.Pending],
                backgroundColor: ['#198754', '#dc3545'], // green & red
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });
</script>
