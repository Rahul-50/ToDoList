@model ToDoList.Models.TodoItem

<div class="container mt-5 col-md-6">
    <h3 class="text-primary mb-3"><i class="fa fa-pen"></i> Edit Task</h3>

    <form asp-action="Update" method="post" class="p-4 shadow rounded bg-light">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" required />
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsCompleted" class="form-check-input" />
            <label asp-for="IsCompleted" class="form-check-label">Mark as Completed</label>
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="fa fa-save"></i> Update
        </button>

        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
