@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-body">
            <h2 class="card-title text-primary mb-4">
                <i class="fa fa-shield-alt"></i> Privacy Policy
            </h2>
            <p class="card-text text-secondary fs-5">
                Your privacy is important to us. This application is designed to collect the minimal amount of personal information necessary for task management purposes.
            </p>

            <ul class="list-group list-group-flush mb-4">
                <li class="list-group-item">✅ We do not sell or share your personal data.</li>
                <li class="list-group-item">✅ Task data is securely stored in a protected SQL database.</li>
                <li class="list-group-item">✅ Cookies are only used for session management (if applicable).</li>
            </ul>

            <p class="text-muted">
                For more details, contact our support team or visit our <a href="https://learn.microsoft.com/aspnet/core" target="_blank">documentation</a>.
            </p>
        </div>
    </div>
</div>
