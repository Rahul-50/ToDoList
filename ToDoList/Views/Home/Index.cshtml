@{
    ViewData["Title"] = "Welcome to Todo App";
}

<div class="container mt-5">
    <div class="p-5 mb-4 rounded-3 shadow" style="background: linear-gradient(to right, #e3f2fd, #f1f8e9);">
        <div class="container-fluid py-5 text-center">
            <img src="https://cdn-icons-png.flaticon.com/512/9197/9197708.png" alt="ToDo Icon" width="120" class="mb-4" />
            <h1 class="display-4 fw-bold text-primary">Welcome to the ToDo App</h1>
            <p class="col-md-8 mx-auto fs-5 text-secondary">
                Organize your daily tasks efficiently with our simple and powerful ToDo list manager built in ASP.NET Core and ADO.NET.
            </p>
            <a href="/Todo/Index" class="btn btn-success btn-lg mt-3 me-2 shadow-sm">
                <i class="fa fa-list"></i> View Tasks
            </a>
            <a href="/Todo/Create" class="btn btn-outline-primary btn-lg mt-3 shadow-sm">
                <i class="fa fa-plus-circle"></i> Add New Task
            </a>
        </div>
    </div>
</div>
